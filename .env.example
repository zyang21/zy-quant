# FutuOpenD Gateway Connection
ZY_FUTU_HOST=127.0.0.1
ZY_FUTU_PORT=11111
# SIMULATE (Paper Trading - Default Safe Mode) or REAL (Live Money)
ZY_TRD_ENV=SIMULATE
# MD5 of 6-digit Futu trade unlock password (only required for REAL mode)
ZY_FUTU_TRADE_PWD_MD5=

# SEC EDGAR Official API requirement (User-Agent header with contact email)
ZY_SEC_USER_AGENT=zy-quant/0.1 (research@example.com)

# Optional Webhook Alerts (Telegram / Feishu / Bark URL)
ZY_ALERT_WEBHOOK_URL=

# Default Account Tier: tier_1k | tier_10k | tier_100k
ZY_ACCOUNT_TIER=tier_1k
